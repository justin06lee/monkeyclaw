# MonkeyClaw development environment image.
#
# Provides everything to run the red -> judge -> repro -> blue codebase AND to
# stand up a real NemoClaw victim, which runs as a nested container via the
# bundled Docker-in-Docker engine.
#
# The build installs tooling only; NemoClaw's installer needs a live Docker
# daemon (it builds a ~2.4 GB sandbox image), so it cannot run at build time.
# Instead the entrypoint prepares the environment automatically on container
# start, then hands off to a shell:
#   - first run (NVIDIA_API_KEY set) -> full NemoClaw setup (starts the inner
#     Docker daemon, installs + onboards NemoClaw, creates the clean-baseline
#     snapshot), then writes a sentinel;
#   - later runs (sentinel present) -> nemoclaw-recover restarts the daemon /
#     gateway / sandbox, reusing the cached sandbox image instead of rebuilding;
#   - with no key -> setup is skipped; the offline mock path is ready.
#
# Live path -- one command brings the whole environment up:
#   docker run -it --rm --privileged -e NVIDIA_API_KEY=<key> <image>
#   uv run monkeyclaw run --cycles 3 --target monkey-victim
#
# Offline/mock path -- no --privileged, no key:
#   docker run -it --rm <image>
#   uv run monkeyclaw run --mock
#
# Live-path host requirements: --privileged, >=8 GB RAM, >=20 GB free disk
# (NemoClaw onboarding can trip the OOM killer below 8 GB).

FROM ubuntu:24.04

# Base tools: curl/ca-certs for the install scripts; git + zstd + sudo are
# required by the NemoClaw installer; iptables by the Docker-in-Docker daemon;
# binutils provides `strings`, which the OpenShell installer uses to verify
# messaging-credential rewrite support (onboarding aborts without it);
# python3-venv lets `nemoclaw onboard` build the model-router venv with the
# SYSTEM python3 (the project's own Python comes from uv and is not used here);
# openssh-client gives `ssh`/`ssh-keygen` -- `openshell forward` shells out to
# /usr/bin/ssh to forward the dashboard port into the sandbox over SSH.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git zstd sudo iptables binutils python3-venv \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Docker-in-Docker: the FULL Docker engine (daemon + CLI + containerd) so a
# NemoClaw victim container can run nested inside this image. MonkeyClaw's
# monitoring harness then `docker exec`s into that nested container normally.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        -o /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22.x: the NemoClaw CLI requires Node >= 22.16 and npm >= 10.
# Installing it system-wide here lets NemoClaw's installer skip its own nvm
# bootstrap and just `npm link` the CLI.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# uv - the MonkeyClaw project's Python package manager.
# The version is pinned (supply-chain hardening): the installer honours
# UV_VERSION, so a compromised install.sh still cannot silently ship a
# different uv build than the one reviewed here. Bump deliberately.
# Installed into /usr/local/bin (not /root/.local) so the unprivileged
# runtime user can run uv too.
ENV UV_VERSION=0.5.11
RUN curl -fsSL https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh
# The project venv lives at /opt/venv -- deliberately OUTSIDE the /app WORKDIR
# so a dev bind-mount of the source over /app (see docker-compose.yml) does not
# shadow it. UV_PROJECT_ENVIRONMENT points every `uv sync` / `uv run` at it.
ENV PATH=/usr/local/bin:/opt/venv/bin:$PATH \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_CACHE_DIR=/opt/uv/cache

WORKDIR /app

# Python dependency layer: copy only the manifests so this stays cached until
# the dependency set changes. uv.lock is copied and `uv sync --frozen` is used
# so the image installs the exact, reviewed dependency versions -- builds are
# reproducible and a resolver change cannot silently pull different versions.
# uv installs Python 3.12 itself (per .python-version); all declared deps ship
# Linux wheels, so no compiler is needed.
COPY pyproject.toml uv.lock .python-version ./
RUN uv python install 3.12 \
    && uv sync --frozen --no-install-project

# MonkeyClaw source + install the package itself (console scripts).
COPY . .
RUN uv sync --frozen

# Runtime helpers onto PATH:
#   nemoclaw-setup       -- starts the nested Docker daemon, runs NemoClaw's
#                           installer + onboarding, creates the clean-baseline
#                           snapshot (deferred to runtime: needs a live daemon)
#   nemoclaw-recover     -- restarts the daemon / gateway / sandbox on a later
#                           container start, reusing the cached sandbox image
#   docker-entrypoint.sh -- entrypoint; runs setup on first start, recover after
RUN install -m 0755 scripts/nemoclaw-setup.sh    /usr/local/bin/nemoclaw-setup \
    && install -m 0755 scripts/nemoclaw-recover.sh  /usr/local/bin/nemoclaw-recover \
    && install -m 0755 scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Drop root for the runtime: the container runs as the unprivileged
# `monkeyclaw` user. The mock path needs no elevation at all. The live path
# (Docker-in-Docker: `dockerd`, NemoClaw's system-wide installer) genuinely
# needs root, so `monkeyclaw` is granted passwordless sudo and the entrypoint
# elevates only that one setup step. The build artifacts (/app project, the
# /opt/venv venv, /opt/uv pythons + cache) are handed to `monkeyclaw` so the
# runtime user can read and update them without root.
RUN useradd -m -s /bin/bash monkeyclaw \
    && echo "monkeyclaw ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/monkeyclaw \
    && chmod 0440 /etc/sudoers.d/monkeyclaw \
    && chown -R monkeyclaw:monkeyclaw /app /opt/uv /opt/venv
USER monkeyclaw

# Dashboard 8787, MCP server 7322, mock MCP 7321 -- documented for reference.
# All bind 127.0.0.1 by default; pass `--host 0.0.0.0` to the MCP servers to
# expose them (the dashboard hardcodes 127.0.0.1 in dashboard.py).
EXPOSE 8787 7321 7322

# The entrypoint runs NemoClaw setup on first start (NVIDIA_API_KEY set) and
# nemoclaw-recover on later starts, then execs CMD -- an interactive shell by
# default.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["bash"]
