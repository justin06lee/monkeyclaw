# Keep `COPY . .` clean: never copy a host-built (Windows) venv, the git
# history, runtime data/logs, or tool caches into the Linux image.
.venv/
.git/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
data/
logs/
.env
*.egg-info/
dist/
build/
.DS_Store

# uv.lock IS copied: the image builds with `uv sync --frozen` so dependency
# versions are reproducible and reviewed. Keep the committed lock current.
