# Example environment file. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored; this template is committed. docker-compose loads `.env`
# into the container via `env_file:` (see docker-compose.yml).

# --- NVIDIA inference keys ---
# Two separate keys so MonkeyClaw's attack loop and the victim agent do not
# share one rate-limit/quota. Both are nvapi-... keys from build.nvidia.com.
#   MC_NVIDIA_API_KEY -> MonkeyClaw's own inference (interfaces/llm.py:
#                        ideation / judge / repro / blue). Read ONLY by our
#                        code; the MC_ prefix never reaches NemoClaw.
#   NVIDIA_API_KEY    -> the NemoClaw victim sandbox's inference provider.
#                        Consumed by `nemoclaw onboard` — the installer
#                        requires this exact (unprefixed) name.
MC_NVIDIA_API_KEY=
NVIDIA_API_KEY=

# --- Brev-hosted LLM (optional) ---
# Run MonkeyClaw against an LLM hosted on an NVIDIA Brev instance instead of
# the NVIDIA-hosted Nemotron endpoint. Brev exposes the model over the same
# OpenAI-compatible protocol. Select it with `--brev` (or MC_LLM_BACKEND=brev).
#   MC_BREV_BASE_URL -> the instance's OpenAI-compatible URL, ending in /v1
#   MC_BREV_API_KEY  -> the instance's API key
#   MC_BREV_MODEL    -> model id served by the instance (optional; falls back
#                       to MC_LLM_MODEL, then the Nemotron default)
MC_BREV_BASE_URL=
MC_BREV_API_KEY=
MC_BREV_MODEL=

# --- Telegram: victim side ---
# Messaging channel baked into the NemoClaw victim sandbox. `nemoclaw onboard`
# auto-ingests TELEGRAM_BOT_TOKEN from the environment (the compose env_file ->
# entrypoint -> onboard chain inherits it, no setup-script change needed).
# Get a token from @BotFather. Leave EMPTY to skip Telegram (onboard records
# `Messaging: none`); a non-empty fake value makes onboarding fail validation.
TELEGRAM_BOT_TOKEN=
MONKEYVICTIM_BOT_USERNAME=

# --- Telegram: MonkeyClaw side (alerting) ---
# infra/notifications.py AlertDispatcher pushes findings/alerts to a Telegram
# chat; consumed via infra/config.py. BOTH must be set for alerts to send,
# otherwise alerts are persisted to the DB only. Use a SEPARATE bot from the
# victim's. MC_TELEGRAM_CHAT_ID is the numeric destination chat/group ID.
MC_TELEGRAM_BOT_TOKEN=
MC_TELEGRAM_CHAT_ID=

# --- Telegram: attacker side (MTProto client API) ---
# Lets MonkeyClaw act as a real Telegram USER account to message the victim's
# bot (a bot cannot message another bot). Obtain both from
# https://my.telegram.org (tied to a phone number). A user session string is
# also needed later, generated once via a phone+code login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
